    "android": {
      "package": "com.sololeveling.gymtracker",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon3.png",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "bundler": "metro",
      "backgroundColor": "#000000"
    },
    "extra": {
      "eas": {
        "projectId": "aa405350-a1ae-4de0-8220-37fec076186c"
      }
    }
